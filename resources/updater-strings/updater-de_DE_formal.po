# Updater strings to merge into the host plugin catalog. No separate runtime domain.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: de_DE_formal\n"

msgid "Private mode must be boolean."
msgstr "Der Private-Modus muss ein boolescher Wert sein."

msgid "Invalid authentication provider."
msgstr "Ungültiger Authentifizierungsanbieter."

msgid "The plugin must be installed in a stable slug directory."
msgstr "Das Plugin muss in einem Verzeichnis mit einem festen Slug installiert sein."

msgid "Invalid GitHub repository URL."
msgstr "Ungültige GitHub-Repository-URL."

msgid "The private update could not be authorized. Check the repository credentials and refresh updates."
msgstr "Das private Update konnte nicht autorisiert werden. Prüfen Sie die Repository-Zugangsdaten und suchen Sie erneut nach Updates."

msgid "Could not create the update download file."
msgstr "Die Datei für den Update-Download konnte nicht erstellt werden."

msgid "The private update download failed. Check credentials and try again."
msgstr "Der Download des privaten Updates ist fehlgeschlagen. Prüfen Sie die Zugangsdaten und versuchen Sie es erneut."

msgid "Could not access the update filesystem."
msgstr "Auf das Dateisystem für das Update konnte nicht zugegriffen werden."

msgid "GitHub release does not contain the plugin main file."
msgstr "Der GitHub-Release enthält nicht die Hauptdatei des Plugins."

msgid "Could not prepare the GitHub release package."
msgstr "Das GitHub-Release-Paket konnte nicht vorbereitet werden."

msgid "See the release on GitHub."
msgstr "Sehen Sie sich den Release auf GitHub an."


msgid "Git Updater is active. If a deckerweb installation or update fails, temporarily deactivate Git Updater and retry. Reactivate it afterwards if other plugins or themes need it. Only leave it disabled when those extensions have another reliable update provider."
msgstr "Git Updater ist aktiv. Wenn eine deckerweb-Installation oder ein Update fehlschlägt, deaktivieren Sie Git Updater vorübergehend und versuchen Sie es erneut. Aktivieren Sie ihn danach wieder, wenn andere Plugins oder Themes ihn benötigen. Lassen Sie ihn nur dauerhaft deaktiviert, wenn diese Erweiterungen einen anderen zuverlässigen Updateweg besitzen."

msgid "Manage installed plugins"
msgstr "Installierte Plugins verwalten"

msgid "Dismiss this notice"
msgstr "Diesen Hinweis ausblenden"

msgid "Permission denied."
msgstr "Zugriff verweigert."

msgid "Public catalog callbacks require both providers and cannot be used in private mode."
msgstr "Öffentliche Katalog-Callbacks benötigen beide Anbieter und können nicht im Private-Modus verwendet werden."

msgid "The approved release could not be verified."
msgstr "Die freigegebene Version konnte nicht geprüft werden."

msgid "The approved release changed. Refresh updates first."
msgstr "Die freigegebene Version hat sich geändert. Suchen Sie zuerst erneut nach Updates."
