msgid "Cleanup supports WPCode Lite 2.4.0 and preserves useful free features."
msgstr ""
"Die Bereinigung unterstützt WPCode Lite 2.4.0 und erhält nützliche Free-"
"Funktionen."

#: includes/history.php:9 includes/history.php:10 includes/history.php:13
msgid "Fixed"
msgstr "Behoben"

#: includes/history.php:9
msgid "Unverified WPCode versions pause cleanup safely."
msgstr "Bei ungeprüften WPCode-Versionen pausiert die Bereinigung sicher."

#: includes/history.php:10
